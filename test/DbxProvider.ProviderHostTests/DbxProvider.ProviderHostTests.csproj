<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DbxProvider.ProviderHostTests</RootNamespace>
    <AssemblyName>DbxProvider.ProviderHostTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The provider's post-build help generation is irrelevant to these
         in-process hosting tests and slows the inner loop; skip it. -->
    <DbxSkipHelpBuild>true</DbxSkipHelpBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.6" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbxProvider\DbxProvider.csproj" />
  </ItemGroup>

</Project>
