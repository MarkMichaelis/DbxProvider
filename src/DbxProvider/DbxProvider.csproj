<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DbxProvider</RootNamespace>
    <AssemblyName>DbxProvider</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbxProvider.FunctionalTests" />
    <InternalsVisibleTo Include="DbxProvider.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dropbox.Api" Version="7.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="System.Management.Automation" Version="7.4.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntelliTect.Dropbox.Auth\IntelliTect.Dropbox.Auth.csproj" />
    <ProjectReference Include="..\IntelliTect.Dropbox.Core\IntelliTect.Dropbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DbxProvider.psd1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="DbxProvider.Format.ps1xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- Allow CI / inner-loop scenarios to skip the help build (e.g. when
         markdown isn't yet authored). Set DbxSkipHelpBuild=true to bypass. -->
    <DbxSkipHelpBuild Condition="'$(DbxSkipHelpBuild)' == ''">false</DbxSkipHelpBuild>
  </PropertyGroup>

  <Target Name="BuildDbxHelp" AfterTargets="Build"
          Condition="'$(DbxSkipHelpBuild)' != 'true'">
    <PropertyGroup>
      <_DbxHelpScript>$(MSBuildThisFileDirectory)..\..\build\Build-Help.ps1</_DbxHelpScript>
    </PropertyGroup>
    <Message Importance="high" Text="Building DbxProvider help (PlatyPS -&gt; MAML)..." />
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_DbxHelpScript)&quot; -Configuration $(Configuration)"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\.." />
  </Target>

  <!-- PowerShell loads this binary module in its own AssemblyLoadContext, which
       does not probe the per-RID runtimes/<rid>/native folder for native
       dependencies. Copy the host-RID SQLite engine (used by the metadata
       cache) next to the managed assemblies so SQLitePCLRaw can P/Invoke it. -->
  <Target Name="CopySqliteNativeToOutput" AfterTargets="Build">
    <ItemGroup>
      <_DbxSqliteNative Include="$(OutDir)runtimes\$(NETCoreSdkRuntimeIdentifier)\native\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DbxSqliteNative)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_DbxSqliteNative)' != ''" />
  </Target>

</Project>